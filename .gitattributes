# Garante LF em todos os ambientes (evita CRLF no Windows quebrando shebangs e scripts)
* text=auto
*.sh  text eol=lf
*.py  text eol=lf
*.md  text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.jsonc text eol=lf
*.html text eol=lf

# Binários — não converter
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.zip  binary
